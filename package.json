{
  "name": "oogvault-desktop",
  "version": "0.1.0",
  "description": "OogVault Desktop — local AI conversation search and knowledge base",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "npm run build:ts && electron .",
    "build": "npm run build:ts && electron-builder --mac",
    "dist": "npm run build:ts && electron-builder"
  },
  "build": {
    "appId": "com.oogvault.desktop",
    "productName": "OogVault",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "renderer/**/*",
      "lib/**/*",
      "assets/**/*",
      "!assets/screenshots/**"
    ]
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "@types/node": "^22.15.30",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  }
}
