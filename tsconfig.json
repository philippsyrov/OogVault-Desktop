{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src-desktop",
    "outDir": ".",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": [
    "src-desktop/**/*.ts",
    "src-desktop/**/*.cts",
    "src-desktop/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "out"
  ]
}
